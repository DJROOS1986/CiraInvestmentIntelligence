# Line endings: stored as LF in Git; explicit per type so Windows tools and Linux CI agree.
* text=auto

*.py         text eol=lf
*.tf         text eol=lf
*.tfvars     text eol=lf
*.hcl        text eol=lf
*.md         text eol=lf
*.json       text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.txt        text eol=lf
*.toml       text eol=lf
*.cfg        text eol=lf
*.sh         text eol=lf
Dockerfile*  text eol=lf
.dockerignore text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf

*.ps1        text eol=crlf
*.psm1       text eol=crlf
*.psd1       text eol=crlf
*.cs         text eol=crlf

# Authenticode-signed scripts must keep their exact bytes (signature covers line endings).
cira_phase58_hardened_v2/** -text

*.png  binary
*.jpg  binary
*.zip  binary
*.xlsx binary
*.pdf  binary
*.exe  binary
